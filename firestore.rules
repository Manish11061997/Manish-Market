rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own documents & subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    // IPO live data: public read (for Firebase hosted site), open write (for backend push via API key)
    match /ipo_data/{document=**} {
      allow read, write: if true;
    }
    // Real-time market data: public read (for Firebase hosted site), open write (for backend push)
    match /market_data/{document=**} {
      allow read, write: if true;
    }
  }
}
